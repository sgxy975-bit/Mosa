+# ---------------------------------------------------------
+# 【新增】Mosa 前端面试流程：/api/interviews
+# 5 道题，简答与选择题混合；简答由 Gemini 评分（无 key 时用规则评分）
+# ---------------------------------------------------------
+TIPS = {
+    "clarity": "Lead with your answer, then give two or three supporting points in order.",
+    "evidence": "Add one concrete number, test result or user quote to back up your claim.",
+    "depth": "Go one level deeper: why this approach, what you rejected, and what it cost.",
+    "relevance": "Answer the exact question first, then add context.",
+}
+FALLBACK_TEXT = [
+    "In two minutes, explain how {title} is built: where do the frontend, backend and data live?",
+    "Tell us about the hardest bug you hit in {title}. How did you find and fix it?",
+    "Who is {title} for, and how do you know they actually need it?",
+    "If usage grew tenfold tomorrow, which part of {title} would break first?",
+]
+FALLBACK_CHOICE = [
+    {"question": "Two days before a demo of {title}, a core feature fails for 1 in 10 users. What do you do first?",
+     "options": ["Reproduce it with logs from failing devices and fix the root cause", "Add a retry button and move on",
+                 "Ask affected users to try another device", "Rewrite the feature in a new framework"], "best": 0,
+     "why": "Find the cause before the demo. A retry hides the bug and a late rewrite adds risk."},
+    {"question": "Which single metric best shows {title} is working a month after launch?",
+     "options": ["Weekly active use of the core feature", "Total sign-ups", "GitHub stars", "Lines of code shipped"], "best": 0,
+     "why": "Repeated real use shows value; sign-ups and stars can grow while nobody uses the product."},
+    {"question": "A teammate pushes straight to main and breaks the build the night before a deadline. Best response?",
+     "options": ["Revert the commit now, then agree on pull-request reviews", "Fix it yourself quietly",
+                 "Leave it until after the deadline", "Remove their write access"], "best": 0,
+     "why": "Restore a working build first, then fix the process."},
+]
+
+
+def build_questions(p: Dict[str, Any]) -> List[Dict[str, Any]]:
+    title = p.get("title") or "this project"
+    hints = [c["interview_hint"] for c in p.get("checks", []) if c.get("interview_hint")][:2]
+    context = {"title": title, "repo": p.get("repo_url"), "summary": p.get("summary"), "languages": p.get("languages"),
+               "scan": {k: v for k, v in (p.get("scan") or {}).items() if k in ("architecture", "stack")}, "weak_points": hints}
+    out = gemini_json(f"""
+        You are a technical interviewer for university student projects. Project context: {json.dumps(context)[:6000]}
+        Write exactly 5 interview questions about THIS project: 3 short-answer and 2 multiple-choice scenario questions, in mixed order.
+        Use the weak points first if any. Return JSON ONLY:
+        {{"questions": [{{"type": "text", "question": "..."}},
+                        {{"type": "choice", "question": "...", "options": ["...", "...", "...", "..."], "best": <index 0-3>, "why": "<one sentence>"}}]}}
+    """)
+    qs = []
+    if isinstance(out, dict) and isinstance(out.get("questions"), list):
+        for q in out["questions"][:5]:
+            if q.get("type") == "choice" and isinstance(q.get("options"), list) and len(q["options"]) >= 2:
+                qs.append({"type": "choice", "text": str(q.get("question", "")), "options": [str(o) for o in q["options"][:4]],
+                           "best": int(q.get("best", 0)) % len(q["options"][:4]), "why": str(q.get("why", ""))})
+            elif q.get("question"):
+                qs.append({"type": "text", "text": str(q["question"])})
+    if len(qs) < 5:
+        texts = [t.format(title=title) for t in FALLBACK_TEXT]
+        texts = list(dict.fromkeys([texts[0], *hints, *texts[1:]]))
+        choices = [dict(c, question=c["question"].format(title=title)) for c in random.sample(FALLBACK_CHOICE, len(FALLBACK_CHOICE))]
+        kinds = ["text", "choice", "text", "choice", "text"]
+        random.shuffle(kinds)
+        qs = []
+        for k in kinds:
+            if k == "choice" and choices:
+                c = choices.pop()
+                qs.append({"type": "choice", "text": c["question"], "options": c["options"], "best": c["best"], "why": c["why"]})
+            else:
+                qs.append({"type": "text", "text": texts.pop(0)})
+    for q in qs:
+        if q["type"] == "choice":
+            order = list(range(len(q["options"])))
+            random.shuffle(order)
+            q["options"] = [{"id": f"o{i}", "text": q["options"][i]} for i in order]
+            q["best"] = f"o{q['best']}"
+    return qs
+
+
+def public_q(q):
+    return {"type": "choice", "text": q["text"], "options": q["options"]} if q["type"] == "choice" else {"type": "text", "text": q["text"]}
+
+
+def heuristic_grade(question: str, text: str) -> Dict[str, Any]:
+    units = len(re.findall(r"[A-Za-z]+", text)) + len(re.findall(r"[一-鿿]", text))
+    depth = 1 if units < 15 else 2 if units < 40 else 3 if units < 90 else 4 if units < 160 else 5
+    evidence = 1 + min(4, len(re.findall(r"\d+%?|for example|e\.g\.|such as|tested|survey|interview|data", text, re.I)))
+    clarity = 1 if units < 15 else min(5, 2 + len(re.findall(r"\b(first|second|then|because|so that|however|finally|therefore)\b", text, re.I)))
+    qt = set(re.findall(r"[a-z]{4,}", question.lower()))
+    ov = len(qt & set(re.findall(r"[a-z]{4,}", text.lower()))) / max(1, len(qt))
+    relevance = 1 if units < 5 else min(5, 2 + round(ov * 8))
+    scores = {"clarity": clarity, "evidence": evidence, "depth": depth, "relevance": relevance}
+    weakest = min(scores, key=scores.get)
+    return {"scores": scores, "score": round(sum(scores.values()) / 4 * 20), "tip": TIPS[weakest], "weakest": weakest}
+
+
+def grade_text(p: Dict[str, Any], question: str, answer: str) -> Dict[str, Any]:
+    out = gemini_json(f"""
+        You interview a university student about their project "{p.get('title')}" ({p.get('repo_url')}).
+        Question: {question}
+        Answer: {answer}
+        Score 1-5 on clarity, evidence, depth, relevance and give one actionable tip.
+        Return JSON ONLY: {{"scores": {{"clarity": n, "evidence": n, "depth": n, "relevance": n}}, "tip": "..."}}
+    """)
+    if isinstance(out, dict) and isinstance(out.get("scores"), dict) and all(isinstance(out["scores"].get(d), (int, float)) for d in TIPS):
+        s = {d: max(1, min(5, int(out["scores"][d]))) for d in TIPS}
+        weakest = min(s, key=s.get)
+        return {"scores": s, "score": round(sum(s.values()) / 4 * 20), "tip": out.get("tip") or TIPS[weakest], "weakest": weakest, "engine": "gemini"}
+    return {**heuristic_grade(question, answer), "engine": "heuristic"}
+
