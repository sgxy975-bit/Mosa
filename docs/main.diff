+@app.post("/api/interviews/{sid}/answer")
+def answer_interview_endpoint(sid: str, req: InterviewAnswerRequest):
+    s = MEM["sessions"].get(sid)
+    if not s:
+        raise HTTPException(404, "Interview session expired. Start a new interview.")
+    qs, answers = s["questions"], s["answers"]
+    idx = req.index if req.index is not None else next((i for i in range(len(qs)) if str(i) not in answers), None)
+    if idx is None or not 0 <= idx < len(qs):
+        raise HTTPException(409, "All questions are already answered.")
+    if str(idx) in answers:
+        raise HTTPException(409, f"Question {idx + 1} is already answered.")
+    q = qs[idx]
+    p = find_project(s["project_id"]) or {}
+    if q["type"] == "choice":
+        pick = req.choice or next((o["id"] for o in q["options"] if o["text"] == req.content), None)
+        if not pick or not any(o["id"] == pick for o in q["options"]):
+            raise HTTPException(422, "Pick one of the options before submitting.")
+        ok = pick == q["best"]
+        v = 5 if ok else 2
+        scores = {"clarity": min(5, v + 1), "evidence": v, "depth": v, "relevance": v}
+        fb = {"scores": scores, "score": round(sum(scores.values()) / 4 * 20), "tip": q.get("why") or "Compare risk, cost and evidence.",
+              "weakest": "depth", "choice": {"picked": pick, "best": q["best"], "correct": ok}}
+        answer_text = next(o["text"] for o in q["options"] if o["id"] == pick)
+    else:
+        answer_text = (req.content or "").strip()
+        if len(answer_text) < 20:
+            raise HTTPException(422, "Write at least 20 characters so the interviewer has something to assess.")
+        fb = grade_text(p, q["text"], answer_text)
+    answers[str(idx)] = {"question": q["text"], "answer": answer_text, "feedback": fb}
+    if db is not None:
+        try:
+            db["verifications"].insert_one({"session_id": sid, "project_id": s["project_id"], "question": q["text"],
+                                            "userAnswer": answer_text, "evaluation": fb, "created_at": get_iso_time()})
+        except Exception as e:
+            print(f"❌ 写入数据库错误: {e}")
+    nxt = next((i for i in range(len(qs)) if str(i) not in answers), None)
+    return {"success": True, "index": idx, "feedback": fb, "done": nxt is None,
+            "next_question": qs[nxt]["text"] if nxt is not None else None, "next_index": nxt,
+            "progress": {"answered": len(answers), "total": len(qs)}}
+
+
+@app.post("/api/interviews/{sid}/finish")
+def finish_interview_endpoint(sid: str):
+    s = MEM["sessions"].get(sid)
+    if not s:
+        raise HTTPException(404, "Interview session expired. Start a new interview.")
+    graded = [a["feedback"] for a in s["answers"].values()]
+    dims = {d: round(sum(f["scores"][d] for f in graded) / len(graded), 1) if graded else 0 for d in TIPS}
+    overall = round(sum(f["score"] for f in graded) / len(graded)) if graded else 0
+    p = find_project(s["project_id"]) or {}
+    trust = p.get("trust_score")
+    readiness = round(0.6 * overall + 0.4 * trust) if trust is not None else overall
+    if p:
+        p["interview"] = {"score": overall, "dims": dims}
+        save_project(p)
+    task_id = f"tsk_{int(time.time() * 1000)}"
+    MEM["tasks"][task_id] = {"id": task_id, "task_id": task_id, "kind": "interview_report", "payload": {"session_id": sid, "project_id": s["project_id"]},
+                             "status": "done", "progress": 100, "step": "done",
+                             "result": {"overall": overall, "dimensions": dims, "readiness": readiness, "trust_score": trust, "answered": len(graded)}}
+    return {"success": True, **MEM["tasks"][task_id]}
+
