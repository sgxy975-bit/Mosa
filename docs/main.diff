+@app.post("/api/interviews")
+def start_interview_endpoint(req: InterviewStartRequest):
+    p = require_project(req.project_id)
+    qs = build_questions(p)
+    sid = f"ses_{int(time.time() * 1000)}"
+    MEM["sessions"][sid] = {"id": sid, "project_id": req.project_id, "persona": req.persona, "questions": qs, "answers": {}, "created_at": get_iso_time()}
+    return {"success": True, "id": sid, "project_id": req.project_id, "persona": req.persona,
+            "questions": [public_q(q) for q in qs], "plan": [q["text"] for q in qs],
+            "turns": [{"role": "interviewer", "content": qs[0]["text"]}]}
