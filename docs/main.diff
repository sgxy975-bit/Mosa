+def find_project(project_id: str) -> Optional[Dict[str, Any]]:
+    if project_id in MEM["projects"]:
+        return MEM["projects"][project_id]
+    if db is not None:
+        try:
+            from bson import ObjectId
+            doc = db["projects"].find_one({"_id": ObjectId(project_id)}) if ObjectId.is_valid(project_id) else db["projects"].find_one({"project_id": project_id})
+            if doc:
+                doc["_id"] = str(doc["_id"])
+                MEM["projects"][project_id] = doc
+                return doc
+        except Exception as e:
+            print(f"⚠️ 数据库读取项目失败: {e}")
+    return None
