+def gemini_json(prompt: str) -> Optional[Any]:
+    """【新增】调用 Gemini 并解析 JSON；失败返回 None，由调用方走备用逻辑"""
+    if not genai_client:
+        return None
+    global GEMINI_MODEL
+    tried: List[str] = []
+    model = GEMINI_MODEL
+    while model and model not in tried:
+        tried.append(model)
+        try:
+            response = genai_client.models.generate_content(
+                model=model,
+                contents=prompt,
+                config=types.GenerateContentConfig(response_mime_type="application/json")
+            )
+            if model != GEMINI_MODEL:
+                print(f"ℹ️ Gemini 模型 {GEMINI_MODEL} 不可用，已改用 {model}（可在 .env 设置 GEMINI_MODEL={model}）")
+                GEMINI_MODEL = model
+            return json.loads(response.text)
+        except Exception as e:
+            msg = str(e)
+            if "NOT_FOUND" in msg or "404" in msg:
+                # 模型对当前账号不可用：优先用报错里推荐的模型，其次用备用列表
+                hint = re.search(r"models/([\w.\-]+) for", msg)
+                nxt = [hint.group(1)] if hint else []
+                nxt += [m for m in GEMINI_FALLBACKS if m not in tried]
+                model = next((m for m in nxt if m not in tried), None)
+                if model:
+                    continue
+            print(f"⚠️ Gemini 调用失败，使用备用逻辑: {e}")
+            return None
+    return None
+
+
