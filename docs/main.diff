+# ---------------------------------------------------------
+
+@app.post("/api/projects/{project_id}/verify")
+def start_verification_endpoint(project_id: str):
+    """【API】调用 Gemini 动态打分并存入 MongoDB（同时用真实仓库数据生成检查项）"""
+    print(f"⚙️ 开始调用 Gemini 评估项目 ID: {project_id}")
+    p = require_project(project_id)
+    repo_url = p["repo_url"]
+
+    try:
+        checks = compute_checks(repo_bundle(repo_url))
+    except GitHubError as e:
+        raise HTTPException(e.status, e.detail)
+    evidence_score = checks_score(checks)
+    calculated_score, ai_summary = evidence_score, "Score calculated from repository evidence."
+
+    res_data = gemini_json(f"""
+        You are a Senior Technical Auditor evaluating a software project for a peer-matching platform.
+        Repository: {repo_url}
+        Evidence checks: {json.dumps([{k: c[k] for k in ('label', 'status', 'detail')} for c in checks])}
+        Evaluate code quality and architecture from this evidence.
+        Return pure JSON ONLY: {{"score": <integer 0-100>, "summary": "<1-2 sentence summary>"}}
+    """)
+    if isinstance(res_data, dict) and isinstance(res_data.get("score"), (int, float)):
+        calculated_score = round((int(res_data["score"]) + evidence_score) / 2)
+        ai_summary = res_data.get("summary") or ai_summary
+        print(f"🤖 Gemini 成功给出打分！Score={calculated_score}")
+
+    verdict = "verified" if calculated_score >= 70 else "partial" if calculated_score >= 40 else "unverified"
+    now_str = get_iso_time()
+    p.update({"trust_score": calculated_score, "ai_summary": ai_summary, "status": verdict, "checks": checks, "updated_at": now_str})
+    save_project(p)
+
+    task_id = f"tsk_{int(time.time() * 1000)}"
+    task = {"id": task_id, "task_id": task_id, "kind": "verify_project", "payload": {"project_id": project_id},
