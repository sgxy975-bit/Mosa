+# ---------------------------------------------------------
+# 【新增】GitHub 仓库读取（带 5 分钟缓存）
+# ---------------------------------------------------------
+REPO_RE = re.compile(r"github\.com[/:]([\w.-]+)/([\w.-]+?)(?:\.git)?/?$", re.I)
+_gh_cache: Dict[str, Any] = {}
+
+
+class GitHubError(Exception):
+    def __init__(self, status: int, detail: str):
+        super().__init__(detail)
+        self.status, self.detail = status, detail
+
+
+def parse_repo(url: Optional[str]):
+    m = REPO_RE.search((url or "").strip())
+    return (m.group(1), m.group(2)) if m else None
+
+
+def gh_get(path: str, params: Optional[dict] = None, raw: bool = False) -> Any:
+    key = path + json.dumps(params or {}, sort_keys=True) + str(raw)
+    hit = _gh_cache.get(key)
+    if hit and time.time() - hit[0] < 300:
+        return hit[1]
+    headers = {"Accept": "application/vnd.github.raw" if raw else "application/vnd.github+json", "User-Agent": "mosa-backend"}
+    if GITHUB_TOKEN:
+        headers["Authorization"] = f"Bearer {GITHUB_TOKEN}"
+    try:
+        r = httpx.get(f"{GITHUB_API}{path}", params=params, headers=headers, timeout=20, follow_redirects=True)
+    except httpx.HTTPError as e:
+        raise GitHubError(502, f"The server can't reach GitHub ({type(e).__name__}). Check its network or proxy settings.")
+    if r.status_code == 404:
+        data = None
+    elif r.status_code in (403, 429):
+        raise GitHubError(429, "GitHub rate limit reached. Set GITHUB_TOKEN in the backend .env and try again.")
+    elif r.status_code >= 400:
+        raise GitHubError(502, f"GitHub returned HTTP {r.status_code}.")
+    else:
+        data = r.text if raw else r.json()
+    _gh_cache[key] = (time.time(), data)
+    return data
+
+
+def repo_bundle(repo_url: str) -> Dict[str, Any]:
+    """读取仓库元数据、目录树、语言、提交、分支、贡献者、README"""
+    parsed = parse_repo(repo_url)
+    if not parsed:
+        raise GitHubError(422, "This project has no valid GitHub repository URL.")
+    owner, name = parsed
+    base = f"/repos/{owner}/{name}"
+    meta = gh_get(base)
+    if meta is None:
+        raise GitHubError(404, f"We couldn't find {owner}/{name}. Make sure the repository is public.")
+    if meta.get("private"):
+        raise GitHubError(403, "This repository is private. Mosa only reads public repositories.")
+    branch = meta.get("default_branch") or "main"
+
+    def soft(path, params=None, raw=False, default=None):
+        try:
+            v = gh_get(path, params, raw)
+            return default if v is None else v
+        except GitHubError as e:
+            if e.status == 429:
+                raise
+            return default
+
+    tree = soft(f"{base}/git/trees/{branch}", {"recursive": "1"}, default={}) or {}
+    return {
+        "owner": owner, "name": name, "branch": branch, "meta": meta,
+        "blobs": [t for t in tree.get("tree", []) if t.get("type") == "blob"], "truncated": bool(tree.get("truncated")),
+        "languages": soft(f"{base}/languages", default={}),
+        "commits": soft(f"{base}/commits", {"per_page": 100}, default=[]),
+        "branches": soft(f"{base}/branches", {"per_page": 10}, default=[]),
+        "contributors": soft(f"{base}/contributors", {"per_page": 100, "anon": 1}, default=[]),
+        "readme": soft(f"{base}/readme", raw=True, default=""),
+    }
+
+
+KIND_RULES = [(r"test|spec", "Tests"), (r"doc", "Docs"), (r"^\.github$|^ci$", "CI"), (r"scene", "Scenes"), (r"shader", "Shaders"),
+              (r"art|asset|image|model|texture|audio|public|static", "Assets"), (r"config|setting|package|infra|root", "Config")]
+
+
+def kind_of(path: str) -> str:
+    for pat, kind in KIND_RULES:
+        if re.search(pat, path, re.I):
+            return kind
+    return "Code"
+
+
+def lang_shares(langs: Dict[str, int]) -> List[Dict[str, Any]]:
+    total = sum(langs.values()) or 1
+    return [{"name": k, "share": max(1, round(v / total * 100))} for k, v in sorted(langs.items(), key=lambda kv: -kv[1])[:6]]
+
+
+def scan_phase(b: Dict[str, Any], phase: str) -> Dict[str, Any]:
+    """四个阶段：validate / architecture / stack / activity，只返回可视化数据，不打分"""
+    meta, branch, blobs = b["meta"], b["branch"], b["blobs"]
+    unity = any(x["path"].startswith("ProjectSettings/") for x in blobs) and any(x["path"].startswith("Assets/") for x in blobs)
+    if phase == "validate":
+        return {"log": f"200 OK · public · default branch {branch}", "data": {"validated": {
+            "visibility": "public", "default_branch": branch, "license": (meta.get("license") or {}).get("spdx_id"),
+            "size_kb": meta.get("size"), "created_at": meta.get("created_at"), "last_push": meta.get("pushed_at"),
+            "stars": meta.get("stargazers_count"), "forks": meta.get("forks_count")}}}
+    if phase == "architecture":
+        groups: Dict[str, Dict[str, Any]] = {}
+        for x in blobs:
+            parts = x["path"].split("/")
+            key = "(root files)" if len(parts) == 1 else parts[0]
+            if unity and parts[0] == "Assets" and len(parts) > 2:
+                key = f"Assets/{parts[1]}"
+            g = groups.setdefault(key, {"size": 0, "files": 0, "sub": Counter(), "loose": []})
+            g["size"] += x.get("size") or 0
+            g["files"] += 1
+            rest = x["path"] if key == "(root files)" else x["path"][len(key) + 1:]
+            if "/" in rest:
+                g["sub"][rest.split("/")[0]] += 1
+            elif len(g["loose"]) < 6:
+                g["loose"].append(rest)
+        total = sum(g["size"] for g in groups.values()) or 1
+        top = sorted(groups.items(), key=lambda kv: -kv[1]["size"])[:8]
+        arch = [{"path": k, "kind": kind_of(k), "share": max(1, round(g["size"] / total * 100)), "files": g["files"]} for k, g in top]
+        tree = [{"name": k, "kind": kind_of(k), "files": g["files"], "share": a["share"],
+                 "children": [{"name": d, "files": n, "children": []} for d, n in g["sub"].most_common(8)] + [{"name": f} for f in g["loose"]]}
+                for (k, g), a in zip(top, arch)]
+        return {"log": f"{len(blobs)} files in {len(arch)} top-level modules{' (tree truncated)' if b['truncated'] else ''}",
+                "data": {"architecture": arch, "tree": tree}}
+    if phase == "stack":
+        languages = lang_shares(b["languages"])
+        paths = [x["path"] for x in blobs]
+        has = lambda pat: any(re.search(pat, p) for p in paths)  # noqa: E731
+        fw = [("Unity", unity), ("URP", has(r"UniversalRP|URP|UniversalRenderPipeline")), ("Meta XR SDK", has(r"(?i)oculus|meta.?xr|OVR")),
+              ("Node.js", has(r"(^|/)package\.json$")), ("React", has(r"\.(jsx|tsx)$")), ("Vite", has(r"vite\.config")),
+              ("Next.js", has(r"next\.config")), ("Python packaging", has(r"(requirements\.txt|pyproject\.toml)$")),
+              ("Docker", has(r"Dockerfile$")), ("GitHub Actions", has(r"^\.github/workflows/")),
+              ("Tailwind CSS", has(r"tailwind\.config")), ("Flutter", has(r"pubspec\.yaml$")), ("TouchDesigner", has(r"\.toe$"))]
+        frameworks = [n for n, ok in fw if ok]
+        return {"log": "Detected " + (", ".join([x["name"] for x in languages] + frameworks)[:120] or "no languages"),
+                "data": {"stack": {"languages": languages, "frameworks": frameworks}}}
+    now = datetime.now(timezone.utc)
+    weekly, items, days = [0] * 12, [], set()
+    for c in b["commits"]:
+        date = ((c.get("commit") or {}).get("author") or {}).get("date")
+        if not date:
+            continue
+        days.add(date[:10])
+        w = (now - datetime.fromisoformat(date.replace("Z", "+00:00"))).days // 7
+        if 0 <= w < 12:
+            weekly[11 - w] += 1
+        items.append({"sha": c["sha"][:7], "msg": (c["commit"].get("message") or "").split("\n")[0][:140],
+                      "author": (c.get("author") or {}).get("login") or c["commit"]["author"].get("name") or "unknown",
+                      "date": date, "branch": branch})
+    return {"log": f"{len(b['commits'])} recent commits · {len(b['contributors'])} contributors · {len(b['branches'])} branches",
+            "data": {"activity": {"weekly": weekly, "recent": items[:5], "list": items,
+                                  "branches": [{"name": x["name"], "active": x["name"] == branch} for x in b["branches"]],
+                                  "commits": len(b["commits"]), "contributors": len(b["contributors"]), "active_days": len(days)}}}
+
+
+CHECKS = [("repo_exists", "Repository exists", 20, "Can you walk us through the repository live and point to the code you wrote?"),
+          ("original_work", "Original work", 10, "This repository is a fork. What did you change compared with the original?"),
+          ("history_depth", "Commit history", 15, "There are few commits. How did development actually happen?"),
+          ("history_spread", "Work spread over time", 15, "Most work landed in a few days. How long did the project take?"),
+          ("team_match", "Team contributions", 10, "Who else worked on this, and what did each person own?"),
+          ("readme", "Documentation", 10, "How does a new user find out what the project does and how to run it?"),
+          ("demo_live", "Live demo", 10, "Where can people use the project today?")]
+
+
+def compute_checks(b: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """【新增】用真实仓库数据生成检查项（前端报告页和面试追问会用到）"""
+    meta, n = b["meta"], len(b["commits"])
+    days = len({((c.get("commit") or {}).get("author") or {}).get("date", "")[:10] for c in b["commits"]} - {""})
+    k, L = len(b["contributors"]), len(b["readme"] or "")
+    res = {
+        "repo_exists": ("pass", f"Found {meta.get('full_name')}"),
+        "original_work": ("warn", "Forked from another repository") if meta.get("fork") else ("pass", "Original repository, not a fork"),
+        "history_depth": ("pass" if n >= 30 else "warn" if n >= 10 else "fail", f"{n}{'+' if n >= 100 else ''} commits"),
+        "history_spread": ("pass" if days >= 7 else "warn" if days >= 3 else "fail", f"Commits on {days} different days"),
+        "team_match": ("pass" if k >= 2 else "warn", f"{k} contributor{'s' if k != 1 else ''}"),
+        "readme": ("pass" if L >= 800 else "warn" if L >= 200 else "fail", f"README is {L:,} characters"),
+        "demo_live": ("warn", "Homepage link found; not checked from the server") if meta.get("homepage") else ("warn", "No demo link provided"),
+    }
+    return [{"id": cid, "label": label, "weight": w, "status": res[cid][0], "detail": res[cid][1],
+             "interview_hint": None if res[cid][0] == "pass" else hint} for cid, label, w, hint in CHECKS]
+
+
+def checks_score(checks: List[Dict[str, Any]]) -> int:
+    f = {"pass": 1, "warn": 0.5, "fail": 0}
+    total = sum(c["weight"] for c in checks) or 1
+    return round(100 * sum(c["weight"] * f.get(c["status"], 0) for c in checks) / total)
+
