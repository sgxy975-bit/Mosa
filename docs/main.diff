+@app.get("/api/projects/{project_id}/skills")
+def skills_endpoint(project_id: str):
+    p = require_project(project_id)
+    if not p.get("checks"):
+        raise HTTPException(409, "Verify the project to unlock skills.")
+    trust = p.get("trust_score") or 0
+    checks = {c["id"]: c for c in p["checks"]}
+    out = []
+    for name, share in (p.get("languages") or {}).items():
+        if share < 10:
+            continue
+        out.append({"name": name, "category": "Language", "verified": trust >= 60, "level": max(1, min(5, round(share / 20))),
+                    "evidence": [f"{share}% of the code in {p['repo_url'].split('github.com/')[-1]}"],
+                    "reason": "" if trust >= 60 else f"Needs a trust score of 60 (currently {trust})."})
+    for name, cid in (("Git workflow", "history_spread"), ("Team collaboration", "team_match"), ("Documentation", "readme")):
+        c = checks.get(cid)
+        if c:
+            out.append({"name": name, "category": "Engineering practice", "verified": c["status"] == "pass",
+                        "level": 4 if c["status"] == "pass" else 2 if c["status"] == "warn" else 1, "evidence": [c["detail"]],
+                        "reason": "" if c["status"] == "pass" else f"{c['label']} check returned {c['status']}."})
+    iv = p.get("interview")
+    for name, dim in (("Technical communication", "clarity"), ("Evidence-based reasoning", "evidence")):
+        v = (iv or {}).get("dims", {}).get(dim)
+        out.append({"name": name, "category": "Communication", "verified": v is not None and v >= 3, "level": round(v) if v else 0,
+                    "evidence": [f"Interview average {v:.1f} / 5 on {dim}"] if v is not None else [],
+                    "reason": "Complete the AI interview to assess this skill." if v is None else "" if v >= 3 else f"Needs an average of 3 / 5 (currently {v:.1f})."})
+    return out
