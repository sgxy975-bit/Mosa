+def save_project(project: Dict[str, Any]) -> None:
+    MEM["projects"][project["id"]] = project
+    if db is not None:
+        try:
+            from bson import ObjectId
+            pid = project["id"]
+            query = {"_id": ObjectId(pid)} if ObjectId.is_valid(pid) else {"project_id": pid}
+            body = {k: v for k, v in project.items() if k != "_id"}
+            db["projects"].update_one(query, {"$set": body}, upsert=True)
+        except Exception as e:
+            print(f"⚠️ 保存项目到数据库失败: {e}")
